# Supabase — same project as TournamentInsights
# SUPABASE_SERVICE_ROLE_KEY must only be used server-side. Never expose to the browser.
# For production, prefer a scoped read-only role over the full service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protects the /api/mcp endpoint until OAuth is added.
# Set to any strong random string (e.g. openssl rand -hex 32).
# Clients must send: Authorization: Bearer <MCP_API_KEY>
MCP_API_KEY=

# The deployed URL of this service (no trailing slash).
# Used for self-referencing and CORS config.
SITE_URL=https://your-vercel-project.vercel.app
