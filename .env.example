# Supabase — same project as TournamentInsights
# SUPABASE_SERVICE_ROLE_KEY must only be used server-side. Never expose to the browser.
# For production, prefer a scoped read-only role over the full service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set to true to enable the write tools (upsert_organizer_watchlist, upsert_partner, etc.)
ENABLE_MCP_WRITES=false

# Set to true to enable the tournament search-history write tools
# (insert_tournament_search_run/scope/finding(s), finalize_tournament_search_run).
# Separate from ENABLE_MCP_WRITES because these are routine/high-frequency writes,
# not rare admin actions. Requires SUPABASE_SERVICE_ROLE_KEY either way.
ENABLE_SEARCH_HISTORY_WRITES=false

# Set to true to return mock data without a real Supabase connection (local dev only).
MOCK_MODE=false

# Protects the /api/mcp endpoint until OAuth is added.
# Set to any strong random string (e.g. openssl rand -hex 32).
# Clients must send: Authorization: Bearer <MCP_API_KEY>
MCP_API_KEY=

# Shared secret for the internal RI import endpoint (upload_tournaments_csv).
# Set the same value in both partner-mcp and the RI Vercel project.
# Minimum 32 characters recommended (e.g. openssl rand -hex 32).
INTERNAL_API_SECRET=

# The deployed URL of this service (no trailing slash).
# Used for self-referencing and CORS config.
SITE_URL=https://partnermcp-git-main-rod-davis-projects.vercel.app
